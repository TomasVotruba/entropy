parameters:
    errorFormat: symplify

    level: 8

    paths:
        - src
        - tests

    treatPhpDocTypesAsCertain: false

    # false positive
    ignoreErrors:
        -
            message: '#Method Entropy\\Container\\Container\:\:make\(\) should return TType of object but returns object#'
            path: src/Container/Container.php

        -
            message: '#Parameter \#2 \$callback of function array_filter expects \(callable\(object\)\: bool\)\|null, Closure\(string\)\: bool given#'
            path: src/Container/Container.php
