parameters:
    errorFormat: symplify

    level: 8

    # lowered for PHP 7.4 support: typed constants, union and mixed native types are 8.x-only,
    # so they live in PHPDoc instead and cannot count toward native type coverage
    type_coverage:
        param_type: 93
        return_type: 98
        property_type: 96
        constant_type: 0

    paths:
        - ecs.php
        - rector.php
        - src
        - tests

    excludePaths:
        # test fixtures
        - */Fixture/*

        # named args used in dev config, project min is 7.4
        - ecs.php
        - rector.php

    symplify:
        ctor: true
        symfonyReturnType: true
        laravelReturnType: true
        pathStrings: true

    treatPhpDocTypesAsCertain: false

    # false positive
    ignoreErrors:
        -
            message: '#Method Entropy\\Container\\Container\:\:make\(\) should return TType of object but returns object#'
            path: src/Container/Container.php

        # useless "generics"
        - message: '#class ReflectionClass but does not specify its types\: T#'

        - '#Parameter \#1 \$objectOrClass of class ReflectionClass constructor expects class\-string<T of object>\|T of object, string given#'

        # dynamic CommentInterface contract
        - '#Call to an undefined method Entropy\\Console\\Contract\\CommandInterface\:\:run\(\)#'
