parameters:
    errorFormat: symplify

    level: 8

    paths:
        - ecs.php
        - rector.php
        - src
        - tests

    excludePaths:
        # test fixtures
        - */Fixture/*

    treatPhpDocTypesAsCertain: false

    # false positive
    ignoreErrors:
        -
            message: '#Method Entropy\\Container\\Container\:\:make\(\) should return TType of object but returns object#'
            path: src/Container/Container.php

        # useless "generics"
        - message: '#class ReflectionClass but does not specify its types\: T#'

        - '#Parameter \#1 \$objectOrClass of class ReflectionClass constructor expects class\-string<T of object>\|T of object, string given#'

        # false positive, always 2 strings
        - '#Method Entropy\\Console\\Input\\InputParser\:\:parseLongOption\(\) should return array\{mixed, mixed\} but returns non\-empty\-list<string>#'

        # dynamic CommentInterface contract
        - '#Call to an undefined method Entropy\\Console\\Contract\\CommandInterface\:\:run\(\)#'

        # playing is safe
        -
            message: '#Strict comparison using \=\=\= between non\-empty\-string and (.*?) will always evaluate to false#'
            path: src/Utils/FileSystem.php
