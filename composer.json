{
    "name": "entropy/entropy",
    "license": "proprietary",
    "description": "Entropy framework",
    "require": {
        "php": "^8.3",
        "ext-tokenizer": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpecs/phpecs": "^2.2",
        "tracy/tracy": "^2.11",
        "phpstan/phpstan": "^2.1",
        "symplify/phpstan-rules": "^14.9",
        "symplify/phpstan-extensions": "^12.0",
        "phpstan/extension-installer": "^1.4",
        "tomasvotruba/type-coverage": "^2.1",
        "shipmonk/composer-dependency-analyser": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Entropy\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Entropy\\Tests\\": "tests",
            "App\\Project\\": [
                "tests/Container/Fixture/project-directory/src",
                "tests/Container/Fixture/project-with-value-objects/src"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
