{
    "name": "entropy/entropy",
    "license": "proprietary",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpecs/phpecs": "^2.2",
        "tracy/tracy": "^2.11",
        "phpstan/phpstan": "^2.1",
        "symplify/phpstan-rules": "^14.9",
        "symplify/phpstan-extensions": "^12.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Entropy\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Entropy\\Tests\\": "tests",
            "App\\Project\\": "tests/Container/Fixture/project-directory/src"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
