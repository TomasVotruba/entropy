{
    "name": "entropy/entropy",
    "license": "proprietary",
    "description": "Entropy framework",
    "require": {
        "php": "^8.4",
        "ext-tokenizer": "*",
        "webmozart/assert": "^2.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "symplify/easy-coding-standard": "^14.2",
        "tracy/tracy": "^2.12",
        "phpstan/phpstan": "^2.1",
        "symplify/phpstan-rules": "^14.10",
        "phpstan/extension-installer": "^1.4",
        "tomasvotruba/type-coverage": "^2.2",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "rector/rector": "^2.4",
        "rector/swiss-knife": "^2.4",
        "tomasvotruba/unused-public": "^2.2",
        "rector/jack": "^1.0",
        "symplify/easy-coding-standard": "^13.1"
    },
    "autoload": {
        "psr-4": {
            "Entropy\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Entropy\\Tests\\": "tests",
            "App\\Project\\": [
                "tests/Container/Autodiscovery/Fixture/project-with-value-objects/src"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
